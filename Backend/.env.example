# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/hospital?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Configuration
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast32BytesLongForSecurity123!
JWT_EXPIRY_MINUTES=15
ADMIN_USERNAME=admin@hospital.com
ADMIN_PASSWORD=AdminPassword123!

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OAuth2 Configuration (Google & GitHub)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRY_DAYS=7

# Email & Notification Configuration
NOTIFICATION_MODE=log
MAIL_FROM=noreply@hospital.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=password
