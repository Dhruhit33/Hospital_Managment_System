						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin@hospital.com\",\n  \"password\": \"AdminPassword123!\"\n}"
						},
						"url": {
